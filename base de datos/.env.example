# Copia este archivo a ".env" (sin ".example") y rellena tus valores reales.

#Variables locales para conexion.py
# DB_HOST=localhost
# DB_PORT=3307
# DB_USER=user
# DB_PASSWORD=pass123
# DB_NAME=Panama_Express

# --- Correo (usadas por correo.py) ---
# Opcion A: Gmail (requiere verificacion en 2 pasos + "contraseña de aplicacion",
# NO la contraseña normal de la cuenta de Gmail):
#   1. Activa la verificacion en 2 pasos en https://myaccount.google.com/security
#   2. Genera una "Contraseña de aplicaciones" en la misma pagina
#      (busca "App passwords" / "Contraseñas de aplicaciones")
#   3. Usa esa contraseña de 16 caracteres como SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=tu_correo@gmail.com
EMAIL_FROM_NOMBRE=Panama Express

# Opcion B (para pruebas locales sin enviar correos reales): Mailtrap
# https://mailtrap.io tiene un "sandbox" gratuito que atrapa los correos
# en una bandeja de pruebas en vez de enviarlos de verdad. Solo cambia:
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=<usuario que te da Mailtrap>
# SMTP_PASSWORD=<contraseña que te da Mailtrap>
# EMAIL_FROM=notificaciones@panamaexpress.test
